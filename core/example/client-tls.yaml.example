# WildPaqet v3 real HTTP/2-covered TLS client (Iran)
role: "client"

log:
  level: "info"

forward:
  - listen: "0.0.0.0:9090"
    target: "127.0.0.1:9090"
    protocol: "tcp"

server:
  addr: "203.0.113.10:443"
  addrs:
    - "203.0.113.11:443"
    - "203.0.113.12:443"
    - "203.0.113.13:443"

transport:
  protocol: "tls"
  # Four outer connections per endpoint reduce one-flow head-of-line stalls.
  # This example has four endpoints, so the total pool size is 4 x 4 = 16.
  conn: 16
  tls:
    mode: "h2"
    # All endpoints in one pool must present a certificate valid for this name.
    server_name: "tunnel.example.com"
    send_server_name: true
    # Omit ca_file for a publicly trusted certificate. Pairing adds it when a
    # private test certificate is used.
    # ca_file: "/etc/paqet/tls/kharej-ca-bundle.crt"
    secret: "replace-with-the-same-32-character-secret"
    alpn: "h2"
    cover_path: "/api/v1/change-this/events"
    client_hello: "chrome"
    connect_timeout: 10
    handshake_timeout: 10
    keepalive: 15
    keepalive_timeout: 60
    connect_jitter: 2
    keepalive_jitter: 5
    max_connection_age: 7200
    connection_age_jitter: 1800
    drain_timeout: 1800
    breaker_failures: 3
    breaker_cooldown: 30
    breaker_max_cooldown: 300
    # Throughput tuning. Each window bounds in-flight bytes to window/RTT and
    # the smallest one wins, so these are sized for a WAN path: on smux v2
    # streambuf applies per stream and is usually the binding limit.
    # 4 MiB allows roughly 335 Mbps for one flow at 100 ms RTT. It is also a
    # latency cost: smux puts every user connection on one TCP stream, so a
    # bulk transfer queues ahead of the rest. Raise it on a fast, well-buffered
    # path; lower it when interactive latency matters more than bulk speed.
    # Both ends must run the same smux_version; v1 ignores streambuf entirely.
    smuxbuf: 8388608
    streambuf: 4194304
    smux_version: 2
